+<?xml version="1.0" encoding="UTF-8"?>
+
+<?import java.lang.*?>
+<?import java.util.*?>
+<?import javafx.scene.*?>
+<?import javafx.geometry.Insets?>
+<?import javafx.scene.chart.PieChart?>
+<?import javafx.scene.control.*?>
+<?import javafx.scene.layout.*?>
+
+<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
+      fx:controller="com.example.farmbook.CropController">
+<padding>
+    <Insets top="20" right="20" bottom="20" left="20"/>
+</padding>
+
+<Label text="Crop Management" style="-fx-font-size: 24px;"/>
+
+<!-- StackPane to hold both Chart and Table -->
+<StackPane VBox.vgrow="ALWAYS">
+    <PieChart fx:id="summaryChart" title="Total Crop Amounts" visible="false"/>
+
+    <TableView fx:id="table">
+        <columns>
+            <TableColumn fx:id="idCol" text="ID"/>
+            <TableColumn fx:id="nameCol" text="Plant Name"/>
+            <TableColumn fx:id="typeCol" text="Type"/>
+            <TableColumn fx:id="amountCol" text="Amount"/>
+            <TableColumn fx:id="dateCol" text="Date Planted"/>
+            <TableColumn fx:id="notesCol" text="Notes"/>
+        </columns>
+    </TableView>
+</StackPane>
+
+<!-- Input Form -->
+<HBox fx:id="formLayout" spacing="10">
+    <TextField fx:id="nameInput" promptText="Plant Name (e.g. Corn)"/>
+    <TextField fx:id="typeInput" promptText="Type (e.g. Grain)"/>
+    <TextField fx:id="amountInput" promptText="Amount"/>
+    <DatePicker fx:id="dateInput" promptText="Date Planted"/>
+    <TextField fx:id="notesInput" promptText="Notes"/>
+</HBox>
+
+<!-- Buttons -->
+<HBox spacing="10">
+    <Button text="Add Crop" onAction="#handleAddCrop"/>
+    <Button text="Update Selected" onAction="#handleUpdateCrop"/>
+    <Button text="Delete Selected" onAction="#handleDeleteCrop"/>
+    <Button fx:id="btnToggleView" text="Show Chart 📊" onAction="#handleToggleView"/>
+    <Button fx:id="btnBack" text="Back to Home" onAction="#handleBack"/>
+</HBox>
+</VBox>
