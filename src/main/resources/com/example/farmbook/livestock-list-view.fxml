<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #3B435F;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.farmbook.LivestockListController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 35px; -fx-font-weight: bold;" text="Farmbook" textFill="WHITE" />
    <Label style="-fx-font-size: 16px;" text="Livestock Records" textFill="WHITE" />

    <Separator />
    <Label style="-fx-font-size: 25px; -fx-font-weight: bold;" text="All Livestock" textFill="WHITE" />

    <ListView fx:id="livestockListView" prefHeight="250.0" prefWidth="400.0" />

    <Button fx:id="addButton" onAction="#handleAddNew" prefHeight="40.0" prefWidth="300.0" style="-fx-font-size: 16px; -fx-background-color: green; -fx-font-weight: bold;" text="Add New Animal" />

    <Button fx:id="backButton" onAction="#handleBack" prefHeight="35.0" prefWidth="300.0" style="-fx-font-size: 14px;" text="Back to Home" />
</VBox>
