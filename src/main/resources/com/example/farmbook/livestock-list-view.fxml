<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.farmbook.LivestockListController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Farmbook" style="-fx-font-size: 35px; -fx-font-weight: bold;"/>
    <Label text="Livestock Records" style="-fx-font-size: 16px;"/>

    <Separator/>
    <Label text="All Livestock" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>

    <ListView fx:id="livestockListView" prefWidth="400.0" prefHeight="250.0"/>

    <Button fx:id="addButton"
            text="Add New Animal"
            onAction="#handleAddNew"
            prefWidth="300.0"
            prefHeight="40.0"
            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Button fx:id="backButton"
            text="Back to Home"
            onAction="#handleBack"
            prefWidth="300.0"
            prefHeight="35.0"
            style="-fx-font-size: 14px;"/>
</VBox>
