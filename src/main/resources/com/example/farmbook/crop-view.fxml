<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" prefHeight="1080.0" prefWidth="1920.0" spacing="20.0"
      styleClass="root-pane" stylesheets="@css/style.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.farmbook.CropController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox opacity="0.98" style="-fx-background-color: #3B435F; -fx-background-radius: 20;" VBox.vgrow="ALWAYS">
        <children>
            <!-- Header Bar -->
            <HBox alignment="CENTER_LEFT">
                <Label prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #2c3247;" text="   Select a crop to edit or add." textFill="WHITE" />
                <Region style="-fx-background-color: #2c3247;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnBack" onAction="#handleBack" prefHeight="37.0" prefWidth="150.0" style="-fx-background-color: #1c202e;" text="Return to dashboard" textFill="WHITE" />
            </HBox>

            <HBox prefHeight="886.0" prefWidth="1880.0" spacing="20.0" VBox.vgrow="ALWAYS">
                <!-- Left Side: Table & Charts Container -->
                <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: #2A3047;">
                    <!-- 1. Table View -->
                    <TableView fx:id="table" style="-fx-control-inner-background: #3B435F; -fx-control-inner-background-alt: #424A69; -fx-base: #2A3047;">
                        <columns>
                            <TableColumn fx:id="idCol" prefWidth="50" text="ID" />
                            <TableColumn fx:id="nameCol" prefWidth="150" text="Plant Name" />
                            <TableColumn fx:id="typeCol" prefWidth="120" text="Type" />
                            <TableColumn fx:id="amountCol" prefWidth="100" text="Amount" />
                            <TableColumn fx:id="dateCol" prefWidth="120" text="Date Planted" />
                            <TableColumn fx:id="notesCol" prefWidth="250" text="Notes" />
                        </columns>
                    </TableView>

                    <!-- 2. Pie Chart View -->
                    <PieChart fx:id="summaryChart" title="Crop Distribution" visible="false" />

                    <!-- 3. Timeline Chart View -->
                    <BarChart fx:id="timeChart" title="Planting Timeline" visible="false">
                        <xAxis>
                            <CategoryAxis label="Date Planted" tickLabelFill="WHITE" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Total Amount" tickLabelFill="WHITE" />
                        </yAxis>
                    </BarChart>
                </StackPane>

                <!-- Right Side: Input Form -->
                <VBox prefWidth="400" spacing="10.0">
                    <Label text="Enter crop details below." textFill="WHITE" />
                    <GridPane hgap="5.0" vgap="10.0" fx:id="formLayout">
                        <columnConstraints>
                            <ColumnConstraints minWidth="90" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Plant Name:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="nameInput" style="-fx-background-color: #1c202e; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Crop Type:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="typeInput" editable="true" style="-fx-background-color: #1c202e; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity" />

                        <Label text="Amount:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <ComboBox fx:id="amountInput" editable="true" style="-fx-background-color: #1c202e; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity" />

                        <Label text="Date Planted:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <DatePicker fx:id="dateInput" style="-fx-control-inner-background: #1c202e;" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="Infinity"/>

                        <Label text="Notes:" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="notesInput" style="-fx-background-color: #1c202e; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </GridPane>

                    <HBox alignment="CENTER" spacing="10.0">
                        <Button onAction="#handleAddCrop" prefHeight="25.0" prefWidth="65.0" style="-fx-background-color: #2193c4;" text="Add" textFill="WHITE" />
                        <Button onAction="#handleUpdateCrop" style="-fx-background-color: green;" text="Update" textFill="WHITE" />
                        <Button onAction="#handleDeleteCrop" style="-fx-background-color: #ff0000;" text="Delete" textFill="WHITE" />
                    </HBox>
                    <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 20 0 0 0;">
                        <Button fx:id="btnToggleView" onAction="#handleToggleView" prefWidth="250.0" style="-fx-background-color: #f39c12;" text="Show Distribution (Pie Chart)" textFill="WHITE" />
                    </HBox>
                </VBox>
            </HBox>
        </children>
    </VBox>
</VBox>