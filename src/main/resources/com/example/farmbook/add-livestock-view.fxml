<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.farmbook.AddLivestockController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Farmbook header -->
    <Label text="Farmbook" style="-fx-font-size: 35px; -fx-font-weight: bold;"/>
    <Label text="Livestock Records" style="-fx-font-size: 16px;"/>

    <Separator/>
    <Label text="Add Livestock" style="-fx-font-size: 25px; -fx-font-weight: bold;"/>

    <!-- Form section -->
    <VBox spacing="8.0" alignment="CENTER">

        <Label text="species:" style="-fx-font-size: 15px"/>
        <TextField fx:id="speciesField" promptText="e.g. Cow" prefWidth="300.0"/>

        <Label text="identifier / tag:" style="-fx-font-size: 15px"/>
        <TextField fx:id="identifierField" promptText="e.g. #A12" prefWidth="300.0"/>

        <Label text="date acquired / born:" style="-fx-font-size: 15px"/>
        <TextField fx:id="dateAcquiredField" promptText="e.g. 2025-02-03" prefWidth="300.0"/>
    </VBox>

    <!-- Save Button -->
    <Button fx:id="saveButton"
            text="Save Animal"
            onAction="#handleSaveLivestock"
            prefWidth="300.0"
            prefHeight="40.0"
            style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <!-- Back Button -->
    <Button fx:id="backButton"
            text="Back to Home"
            onAction="#handleBack"
            prefWidth="300.0"
            prefHeight="35.0"
            style="-fx-font-size: 14px;"/>

    <!-- Status -->
    <Label fx:id="statusLabel" style="-fx-font-size: 14px;"/>
</VBox>
