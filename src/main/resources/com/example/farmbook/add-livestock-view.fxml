<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="12.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.farmbook.AddLivestockController"
      stylesheets="@css/style.css">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <Label text="Add Livestock" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E3A23;"/>

    <Label text="Species"/>
    <TextField fx:id="speciesField" promptText="e.g. Cow"/>

    <Label text="Identifier / Tag"/>
    <TextField fx:id="identifierField" promptText="e.g. #A12"/>

    <Label text="Date Acquired / Born"/>
    <TextField fx:id="dateAcquiredField" promptText="e.g. 2025-02-03"/>

    <Button text="Save Animal" onAction="#handleSaveLivestock"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: green;"/>
</VBox>
