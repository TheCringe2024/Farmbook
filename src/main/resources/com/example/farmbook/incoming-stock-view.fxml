<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" style="-fx-background-color: #3B435F;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.farmbook.IncomingStockController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Incoming Stock" textFill="WHITE" />

    <Label text="Item" textFill="WHITE" />
    <ComboBox fx:id="itemComboBox" prefWidth="300.0" />

    <Label text="Quantity" textFill="WHITE" />
    <TextField fx:id="quantityField" promptText="e.g. 20" />

    <Label text="Date" textFill="WHITE" />
    <TextField fx:id="dateField" promptText="e.g. 2025-08-12" />

    <Label text="Source (optional)" textFill="WHITE" />
    <TextField fx:id="sourceField" promptText="e.g. Supplier name" />

    <Button onAction="#handleAddStock" style="-fx-background-color: green;" text="Add Stock" />

    <Label fx:id="statusLabel" style="-fx-text-fill: green;" />
</VBox>
