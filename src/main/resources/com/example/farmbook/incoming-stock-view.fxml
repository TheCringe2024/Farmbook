<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.farmbook.IncomingStockController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Incoming Stock" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Item"/>
    <ComboBox fx:id="itemComboBox" prefWidth="300.0"/>

    <Label text="Quantity"/>
    <TextField fx:id="quantityField" promptText="e.g. 20"/>

    <Label text="Date"/>
    <TextField fx:id="dateField" promptText="e.g. 2025-08-12"/>

    <Label text="Source (optional)"/>
    <TextField fx:id="sourceField" promptText="e.g. Supplier name"/>

    <Button text="Add Stock" onAction="#handleAddStock"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: green;"/>
</VBox>
